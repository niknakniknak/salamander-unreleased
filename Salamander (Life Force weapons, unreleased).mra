<misterromdescription>
    <name>Salamander (Life Force weapons, unreleased)</name>
    <mameversion>0000</mameversion>
    <setname>salamandgo</setname>
    <year>1986</year>
    <manufacturer>Konami</manufacturer>
    <category>Shmup</category>
    <rbf>Salamander</rbf>
    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <players>1</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>3</num_buttons>

    <switches default="FF,5B,F7">
        <!-- DSW1 -->
        <dip bits="0,3"         name="Coin A"       ids="Invalid,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/7,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip bits="4,7"         name="Coin B"       ids="Invalid,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/7,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <!-- DSW2 -->
        <dip bits="8,9"         name="Lives"        ids="6,5,4,3"/>
        <dip bits="10"          name="Coin slots"   ids="2,1"/>
        <dip bits="11,12"       name="Bonus life"   ids="100k only,70k only,100k/every 300k,70k/every 200k"/>
        <dip bits="13,14"       name="Difficulty"   ids="hardest,hard,normal,easy"/>
        <dip bits="15"          name="Demo sound"   ids="on,off"/>
        <!-- DSW3 -->
        <dip bits="16"          name="Flip screen"  ids="flip,normal"/>
        <dip bits="18"          name="Service mode" ids="on,off"/>
        <dip bits="19"          name="Cabinet type" ids="upright,cocktail"/>
    </switches>

    <rom index='0' md5="None" type='nonmerged' zip='salamandgo.zip'>
        <!-- graphic data hi    0x000000-0x01ffff -->
        <part crc="0b412515" name="lfp.17b"/>
        <!-- graphic data lo    0x020000-0x03ffff -->
        <part crc="17400273" name="lfp.17c"/>

        <!-- pcm samples        0x040000-0x05ffff -->
        <part crc="09fe0632" name="587-c01.10a"/>

        <!-- game program hi    0x060000-0x06ffff -->
        <part crc="7930ac18" name="lfp.18b"/>
        <!-- game program lo    0x070000-0x07ffff -->
        <part crc="a4379887" name="lfp.18c"/>

        <!-- sound program      0x080000-0x087fff -->
        <part crc="d70e491e" name="lfp.11j"/>

        <!-- vlm commands       0x088000-0x08bfff -->
        <part crc="f178e685" name="lfp.8g"/>
    </rom>

    <buttons default="Select,R,L,A,B,X" names="Service,Coin,Start,Power-up,Shoot,Missile"></buttons>
</misterromdescription>
